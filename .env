# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURAÇÃO DO BOT DISCORD - PROFESSIONAL EDITION
# ═══════════════════════════════════════════════════════════════════════════

# Token do Bot Discord
# Obtenha em: https://discord.com/developers/applications
TOKEN=SeuTokenDiscordAqui

# ID do servidor para registro rápido de comandos slash (OPCIONAL)
# Se preenchido, os comandos serão registrados instantaneamente neste servidor.
# Para obter: Ative o Modo Desenvolvedor no Discord > Clique com botão direito no servidor > Copiar ID
GUILD_ID=IdDaSuaLoja

# ID do desenvolvedor (OPCIONAL)
# Para obter seu ID: Ative o Modo Desenvolvedor no Discord > Clique com botão direito no seu perfil > Copiar ID
DEVELOPER_ID=DeuIDDiscordAqui


# ═══════════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES:
# - Nunca compartilhe seu TOKEN com ninguém
# - O arquivo .env não deve ser commitado no Git (já está no .gitignore)
# - GUILD_ID é opcional e serve apenas para testes rápidos
# ═══════════════════════════════════════════════════════════════════════════
