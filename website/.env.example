# ===================================================================
# Bot License Manager — Website
# ===================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Banco de Dados (MySQL) ---
DATABASE_URL=mysql://usuario:senha@localhost:3306/bot_license_manager

# --- Sessão / Cookies ---
# String longa e aleatória usada pra assinar o JWT de sessão.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Login (Discord OAuth2) ---
# Crie uma aplicação em https://discord.com/developers/applications
# Em OAuth2 > Redirects, cadastre exatamente a mesma URL de DISCORD_REDIRECT_URI abaixo.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Seu Discord ID (usuário dono do sistema). Quem logar com esse ID
# vira automaticamente "admin" no painel.
OWNER_OPEN_ID=

# --- Stripe (pagamentos/licenças) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Instâncias de bot (execução isolada por cliente) ---
BOT_INSTANCES_DIR=./bot-instances

# ===================================================================
# Variáveis abaixo são resquício da plataforma Manus (usadas só por
# recursos de demonstração que não fazem parte do fluxo real do site:
# chat de IA, geração de imagem, mapa e transcrição de voz na página
# ComponentShowcase). Pode deixar em branco.
# ===================================================================
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
